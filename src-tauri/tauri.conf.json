{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Google-Companion Notchbar",
  "version": "0.2.0",
  "identifier": "app.notch.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "notch",
        "title": "Google-Companion Notchbar",
        "width": 760,
        "height": 560,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,msEdgeTranslate,OptimizationHints,MediaRouter,AutofillServerCommunication --disable-component-update --disable-sync --no-pings --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGRjFDOUNBQTJDNzBCRkYKUldUL0M4ZWl5c254cnhYRGV5OXNCbDBPNWMzR3FRRzFESk9LZXBlcXg0OHgvOGJobHlDOWU3SnkK",
      "endpoints": [
        "https://github.com/Screamycat/Google-Companion-Notchbar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
